{
  "name": "@llm-series/vector-store-lite",
  "version": "0.1.0",
  "description": "In-memory vector store with cosine similarity search — module #8a",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
