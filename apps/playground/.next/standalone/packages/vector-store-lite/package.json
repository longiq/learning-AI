    "prepublishOnly": "pnpm run build && pnpm run typecheck"
  },
  "files": ["dist"],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
}
